rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidExportFormat(fmt) {
      return fmt is string && fmt in ['PNG', 'SVG', 'JPEG', 'PDF'];
    }

    function isValidEcc(ecc) {
      return ecc is string && ecc in ['L', 'M', 'Q', 'H'];
    }

    // Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'defaultExportFormat',
          'defaultExportSize',
          'defaultEcc',
          'defaultMargin',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('defaultExportFormat' in data) || isValidExportFormat(data.defaultExportFormat))
        && (!('defaultExportSize' in data) || (data.defaultExportSize is number && data.defaultExportSize >= 256 && data.defaultExportSize <= 4096))
        && (!('defaultEcc' in data) || isValidEcc(data.defaultEcc))
        && (!('defaultMargin' in data) || (data.defaultMargin is number && data.defaultMargin >= 0 && data.defaultMargin <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedProject(data, userId, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'kind', 'category', 'payload', 'favorite', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'kind',
          'category',
          'payload',
          'favorite',
          'thumbnailDataUrl',
          'qrForm',
          'qrDesign',
          'barcodeConfig',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == projectId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.kind is string && data.kind in ['qr', 'barcode']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.payload is string && data.payload.size() >= 1 && data.payload.size() <= 4000
        && data.favorite is bool
        && (!('thumbnailDataUrl' in data) || (data.thumbnailDataUrl is string && data.thumbnailDataUrl.size() <= 200000))
        && (!('qrForm' in data) || data.qrForm is map)
        && (!('qrDesign' in data) || data.qrDesign is map)
        && (!('barcodeConfig' in data) || data.barcodeConfig is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryEntry(data, userId, entryId) {
      return data.keys().hasAll(['id', 'ownerId', 'action', 'kind', 'title', 'category', 'payload', 'createdAt'])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'action',
          'kind',
          'title',
          'category',
          'payload',
          'format',
          'projectSnapshot',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == entryId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.action is string && data.action in ['created', 'downloaded', 'updated']
        && data.kind is string && data.kind in ['qr', 'barcode']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.payload is string && data.payload.size() >= 1 && data.payload.size() <= 4000
        && (!('format' in data) || isValidExportFormat(data.format))
        && (!('projectSnapshot' in data) || data.projectSnapshot is map)
        && data.createdAt is timestamp;
    }

    // Isolated Private User Profile & Settings
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && docId == 'profile'
        && isOwner(userId) && isVerifiedUser();

      allow create: if isValidId(userId) && isValidId(docId) && docId == 'profile'
        && isOwner(userId) && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId) && isValidId(docId) && docId == 'profile'
        && isOwner(userId) && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'photoURL',
            'defaultExportFormat',
            'defaultExportSize',
            'defaultEcc',
            'defaultMargin',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isValidId(docId) && docId == 'profile'
        && isOwner(userId) && isVerifiedUser();
    }

    // Isolated Saved QR & Barcode Projects
    match /users/{userId}/projects/{projectId} {
      allow get: if isValidId(userId) && isValidId(projectId)
        && isOwner(userId) && isVerifiedUser()
        && existing().ownerId == request.auth.uid;

      allow list: if isValidId(userId)
        && isOwner(userId) && isVerifiedUser()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isValidId(userId) && isValidId(projectId)
        && isOwner(userId) && isVerifiedUser()
        && isValidSavedProject(incoming(), userId, projectId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId) && isValidId(projectId)
        && isOwner(userId) && isVerifiedUser()
        && isValidSavedProject(incoming(), userId, projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['favorite', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'category',
            'payload',
            'qrForm',
            'qrDesign',
            'barcodeConfig',
            'thumbnailDataUrl',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isValidId(projectId)
        && isOwner(userId) && isVerifiedUser()
        && existing().ownerId == request.auth.uid;
    }

    // Isolated User Creation & Download History
    match /users/{userId}/history/{entryId} {
      allow get: if isValidId(userId) && isValidId(entryId)
        && isOwner(userId) && isVerifiedUser()
        && existing().ownerId == request.auth.uid;

      allow list: if isValidId(userId)
        && isOwner(userId) && isVerifiedUser()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isValidId(userId) && isValidId(entryId)
        && isOwner(userId) && isVerifiedUser()
        && isValidHistoryEntry(incoming(), userId, entryId)
        && incoming().createdAt == request.time;

      allow delete: if isValidId(userId) && isValidId(entryId)
        && isOwner(userId) && isVerifiedUser()
        && existing().ownerId == request.auth.uid;
    }
  }
}
